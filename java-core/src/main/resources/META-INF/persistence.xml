<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="budgetPU" transaction-type="RESOURCE_LOCAL">

        <class>com.budgetapp.entities.Business</class>
        <class>com.budgetapp.entities.BusinessUnit</class>
        <class>com.budgetapp.entities.AppUser</class>
        <class>com.budgetapp.entities.BudgetSubmission</class>
        <class>com.budgetapp.entities.FinancialLineItem</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
					  value="jdbc:postgresql://localhost:5432/budget_prototype"/>
			<property name="jakarta.persistence.jdbc.user"
					  value="budget"/>
<property name="jakarta.persistence.jdbc.password"
          value="budgetpass"/>

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto"
                      value="none"/>
            <property name="hibernate.show_sql"
                      value="true"/>
            <property name="hibernate.format_sql"
                      value="true"/>
        </properties>

    </persistence-unit>

</persistence>