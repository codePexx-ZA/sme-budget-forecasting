<?xml version="1.0" encoding="utf-8"?>
<!-- Create or edit a draft (Aiden). Dates open a picker. Amounts are entered in rands. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Sme.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/nav_back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:subtitle="@string/form_toolbar_subtitle"
        app:title="@string/submission_new" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/formScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/form_intro"
                    android:textAppearance="@style/TextAppearance.Sme.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_32"
                    android:text="@string/section_period"
                    android:textAppearance="@style/TextAppearance.Sme.Section" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/form_period_help"
                    android:textAppearance="@style/TextAppearance.Sme.BodyMuted" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/periodStartLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:hint="@string/period_start">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/periodStartInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/periodEndLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:hint="@string/period_end">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/periodEndInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/thisYearButton"
                        style="@style/Widget.Sme.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:layout_weight="1"
                        android:text="@string/fy_this" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nextYearButton"
                        style="@style/Widget.Sme.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/fy_next" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/fy_help"
                    android:textAppearance="@style/TextAppearance.Sme.BodyMuted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_32"
                    android:text="@string/section_source"
                    android:textAppearance="@style/TextAppearance.Sme.Section" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/importMethodLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:hint="@string/import_method">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/importMethodInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sourceScaleLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:hint="@string/source_scale">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/sourceScaleInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fileNameLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:hint="@string/source_file">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fileNameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="255" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/replacesLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:hint="@string/replaces_submission">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/replacesInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copyLinesButton"
                    style="@style/Widget.Sme.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/copy_lines" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/amount_hint"
                    android:textAppearance="@style/TextAppearance.Sme.BodyMuted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_32"
                    android:text="@string/line_items"
                    android:textAppearance="@style/TextAppearance.Sme.Section" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/form_lines_help"
                    android:textAppearance="@style/TextAppearance.Sme.BodyMuted" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_table"
                    android:clipToOutline="true"
                    android:fillViewport="true"
                    android:padding="1dp"
                    android:scrollbars="horizontal">

                    <TableLayout
                        android:id="@+id/linesContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:stretchColumns="*">

                        <TableRow
                            android:id="@+id/lineHeaderRow"
                            android:background="@drawable/bg_table_header"
                            android:divider="@drawable/divider_table"
                            android:showDividers="middle">

                            <TextView
                                style="@style/Widget.Sme.TableHeader"
                                android:layout_width="148dp"
                                android:layout_height="wrap_content"
                                android:minWidth="148dp"
                                android:text="@string/category" />

                            <TextView
                                style="@style/Widget.Sme.TableHeader"
                                android:layout_width="132dp"
                                android:layout_height="wrap_content"
                                android:minWidth="132dp"
                                android:text="@string/section_period" />

                            <TextView
                                style="@style/Widget.Sme.TableHeader"
                                android:layout_width="132dp"
                                android:layout_height="wrap_content"
                                android:minWidth="132dp"
                                android:text="@string/amount" />

                            <TextView
                                style="@style/Widget.Sme.TableHeader"
                                android:layout_width="124dp"
                                android:layout_height="wrap_content"
                                android:minWidth="124dp"
                                android:text="@string/frequency" />

                            <TextView
                                style="@style/Widget.Sme.TableHeader"
                                android:layout_width="96dp"
                                android:layout_height="wrap_content"
                                android:minWidth="96dp"
                                android:text="@string/remove_line" />
                        </TableRow>
                    </TableLayout>
                </HorizontalScrollView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addLineButton"
                    style="@style/Widget.Sme.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/add_line" />

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textAppearance="@style/TextAppearance.Sme.Error"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/loadErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/screen_padding"
            android:textAppearance="@style/TextAppearance.Sme.Error"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveButton"
        style="@style/Widget.Sme.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_padding"
        android:text="@string/save_draft"
        android:visibility="gone" />
</LinearLayout>
