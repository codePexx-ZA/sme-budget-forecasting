<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.Sme.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/nav_back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:subtitle="@string/report_subtitle"
        app:title="@string/report_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Sme.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_callout"
                        android:orientation="vertical"
                        android:padding="@dimen/space_16">

                        <TextView
                            android:id="@+id/businessName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Sme.Title" />

                        <TextView
                            android:id="@+id/unitName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:textAppearance="@style/TextAppearance.Sme.Body" />

                        <TextView
                            android:id="@+id/preparedText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:textAppearance="@style/TextAppearance.Sme.Caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Widget.Sme.SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/report_section_results" />

                <LinearLayout
                    android:id="@+id/resultContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Widget.Sme.SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/report_section_compare" />

                <TextView
                    android:id="@+id/historyNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textAppearance="@style/TextAppearance.Sme.Caption" />

                <TextView
                    android:id="@+id/forecastNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textAppearance="@style/TextAppearance.Sme.Caption" />

                <TextView
                    android:id="@+id/excludedNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_status_waiting"
                    android:padding="@dimen/space_12"
                    android:textAppearance="@style/TextAppearance.Sme.Body"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/rowContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Widget.Sme.SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/report_section_targets" />

                <TextView
                    android:id="@+id/targetsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/report_targets_empty"
                    android:textAppearance="@style/TextAppearance.Sme.BodyMuted"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/targetContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Widget.Sme.SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/report_section_warnings" />

                <TextView
                    android:id="@+id/warningsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/report_warnings_empty"
                    android:textAppearance="@style/TextAppearance.Sme.BodyMuted"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/warningContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Widget.Sme.SectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="@string/report_section_history" />

                <TextView
                    android:id="@+id/approvalsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/report_approvals_empty"
                    android:textAppearance="@style/TextAppearance.Sme.BodyMuted"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/approvalContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/report_footnote"
                    android:textAppearance="@style/TextAppearance.Sme.Caption" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/screen_padding"
            android:textAppearance="@style/TextAppearance.Sme.Error"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/shareButton"
        style="@style/Widget.Sme.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_padding"
        android:enabled="false"
        android:text="@string/report_share" />
</LinearLayout>
