<resources>
    <style name="TextAppearance.Sme.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Sme.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Sme.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Sme.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.Sme.BodyMuted" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.Sme.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.Sme.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Sme.Error" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/brand_error</item>
    </style>

    <style name="TextAppearance.Sme.ToolbarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/brand_on_primary</item>
    </style>

    <style name="TextAppearance.Sme.ToolbarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/brand_on_primary</item>
    </style>

    <style name="Widget.Sme.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/brand_primary</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextColor">@color/brand_on_primary</item>
        <item name="subtitleTextColor">@color/brand_on_primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.Sme.ToolbarTitle</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Sme.ToolbarSubtitle</item>
        <item name="navigationIconTint">@color/brand_on_primary</item>
    </style>

    <style name="Widget.Sme.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/control_radius</item>
    </style>

    <style name="Widget.Sme.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/control_radius</item>
        <item name="strokeColor">@color/brand_primary</item>
    </style>

    <style name="Widget.Sme.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/control_radius</item>
        <item name="android:textColor">@color/brand_error</item>
        <item name="strokeColor">@color/brand_error</item>
    </style>

    <style name="Widget.Sme.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Sme.Button.DangerText" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/brand_error</item>
    </style>

    <style name="Widget.Sme.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface_raised</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
    </style>

    <style name="Widget.Sme.Status" parent="TextAppearance.Sme.Label">
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Sme.Table" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.Sme.TableHeader" parent="android:Widget.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Sme.Label</item>
        <item name="android:textColor">@color/on_primary_container</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
