# Copy this file to .env (same folder) and fill in your own values. Never commit .env.
# POSTGRES_PASSWORD must match the one in csharp-ingestion/.env (the Docker database).
POSTGRES_PASSWORD=budgetpass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=budget_prototype
POSTGRES_USER=budget
# How long a login stays valid, in hours.
SESSION_HOURS=8
